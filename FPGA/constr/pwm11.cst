//File Title: Physical Constraints file
//Tool Version: V1.9.12.03 (64-bit)
//Part Number: GW1NSR-LV4CQN48PC7/I6
//Device: GW1NSR-4C
//Created Time: Wed 08 05 15:51:51 2026

// 1. Clock 27MHz (BANK 1 - 3.3V)[cite: 3]
IO_LOC "clk_in" 45;
IO_PORT "clk_in" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// 2. Chân Reset (Chọn Pin 40 trống ở BANK 1 - 3.3V, ngay cạnh chân UART TX)
IO_LOC "rst_n_in" 40;
IO_PORT "rst_n_in" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// 3. Hai nút nhấn Mode (BANK 3 - 1.8V)[cite: 3]
IO_LOC "btn1_in" 14;
IO_PORT "btn1_in" IO_TYPE=LVCMOS18 PULL_MODE=UP;

IO_LOC "btn2_in" 15;
IO_PORT "btn2_in" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// 4. LED hiển thị PWM (Chọn LED2 ở BANK 3 - 1.8V)[cite: 3]
IO_LOC "led_out" 13;
IO_PORT "led_out" IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8;

// 5. Cổng truyền UART TX (BANK 1 - 3.3V)[cite: 3]
IO_LOC "uart_tx" 39;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;